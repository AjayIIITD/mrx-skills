      {"name": "Saket - Select CITYWALK", "zone_type": "safe", "description": "Commercial area with good lighting and security", "polygon": "[[28.5220,77.2130],[28.5280,77.2210],[28.5210,77.2240],[28.5160,77.2160]]"},
      {"name": "Dwarka Sector 6-12", "zone_type": "caution", "description": "Residential area, moderately lit, moderate foot traffic after 10 PM", "polygon": "[[28.5880,77.0380],[28.5960,77.0500],[28.5870,77.0550],[28.5800,77.0430]]"},
      {"name": "Old Delhi (Chandni Chowk area)", "zone_type": "caution", "description": "Dense narrow lanes, crowded but can be unsafe after dark", "polygon": "[[28.6540,77.2260],[28.6600,77.2360],[28.6520,77.2410],[28.6470,77.2310]]"},
      {"name": "Mahipalpur - Rangpuri", "zone_type": "unsafe", "description": "Isolated stretches near airport, poorly lit, low foot traffic", "polygon": "[[28.5400,77.1160],[28.5480,77.1250],[28.5400,77.1300],[28.5320,77.1200]]"},
